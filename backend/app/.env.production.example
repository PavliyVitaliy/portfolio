APP_CONFIG__DB__URL=postgresql+asyncpg://portfolio:change-me@portfolio-postgres-db:5432/portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio

APP_CONFIG__MONGO__URI=mongodb://portfolio:change-me@portfolio-mongo-db:27017/portfolio?authSource=portfolio
APP_CONFIG__MONGO__DB=portfolio
MONGO_INITDB_ROOT_USERNAME=change-me
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DB_USER=portfolio
MONGO_DB_PASSWORD=change-me
MONGO_DB_NAME=portfolio

ENVIRONMENT=production
APP_CONFIG__ACCESS_TOKEN__RESET_PASSWORD_TOKEN_SECRET=change-me-to-a-long-random-secret
APP_CONFIG__ACCESS_TOKEN__VERIFICATION_TOKEN_SECRET=change-me-to-a-long-random-secret
APP_CONFIG__SUPER_USER__EMAIL=admin@example.com
APP_CONFIG__SUPER_USER__PASSWORD=change-me

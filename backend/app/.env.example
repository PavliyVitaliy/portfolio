# Local Docker Compose development settings. Do not use these credentials in production.
APP_CONFIG__DB__URL=postgresql+asyncpg://portfolio:portfolio@portfolio-postgres-db:5432/portfolio
APP_CONFIG__DB__ECHO=false
POSTGRES_PASSWORD=portfolio
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio

APP_CONFIG__MONGO__URI=mongodb://portfolio:portfolio@portfolio-mongo-db:27017/portfolio?authSource=portfolio
APP_CONFIG__MONGO__DB=portfolio
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_DB_USER=portfolio
MONGO_DB_PASSWORD=portfolio
MONGO_DB_NAME=portfolio

ENVIRONMENT=development
APP_CONFIG__ACCESS_TOKEN__RESET_PASSWORD_TOKEN_SECRET=local-reset-token-secret-change-before-production
APP_CONFIG__ACCESS_TOKEN__VERIFICATION_TOKEN_SECRET=local-verification-token-secret-change-before-production
APP_CONFIG__SUPER_USER__EMAIL=admin@example.com
APP_CONFIG__SUPER_USER__PASSWORD=admin
